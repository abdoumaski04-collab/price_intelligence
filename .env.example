# ==========================================
# 🔑 Google Cloud Platform (GCP)
# ==========================================
# Chemin vers votre fichier de clé de compte de service GCP
# Ne jamais committer le fichier .json réel — mettez-le dans credentials/
GOOGLE_APPLICATION_CREDENTIALS="./credentials/gcp-key.json"
GCP_PROJECT_ID="diesel-patrol-491520-j8"
GCP_DATASET_ID="jumia_price_intelligence"

# ==========================================
# ⚙️ Mode de données
# ==========================================
# "csv" pour développement local, "bigquery" pour production
DATA_MODE="csv"

# ==========================================
# 🐋 Infrastructure Docker
# ==========================================
NIFI_USERNAME="admin"
NIFI_PASSWORD="changez-moi-en-production!"
AIRFLOW_ADMIN_PASSWORD="changez-moi-en-production!"

# ==========================================
# 🌐 API FastAPI
# ==========================================
API_HOST="0.0.0.0"
API_PORT="8000"
ALLOWED_ORIGINS="http://localhost:4200"